# Server only. Never include these values in browser code.
OPENAI_API_KEY=

# Current OpenAI models. Flare favors fast everyday image generation over precision editing.
OPENAI_MENU_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Must be on a persistent local volume. Run one worker and one replica.
DATA_DIR=./data

# Set true for a hosted HTTPS release. Leave false for local HTTP.
SECURE_COOKIES=false

# Hard caps per server over a rolling 24-hour window, including failed attempts.
# Set 0 to disable new paid requests of that kind.
DAILY_SCAN_LIMIT=100
DAILY_IMAGE_LIMIT=100
