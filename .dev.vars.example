MODEL_API_KEY=
OPENAI_API_KEY=
MUSE_MENU_MODEL=muse-ember-1.0
MUSE_IMAGE_MODEL=muse-image-1.0
OPENAI_MENU_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
