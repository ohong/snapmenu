{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snapmenu",
  "account_id": "acc011aa86ca151f8a63c5047ae1ebf9",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "AI_PROVIDER": "muse",
    "DAILY_SCAN_LIMIT": "100",
    "DAILY_IMAGE_LIMIT": "100",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snapmenu",
      "database_id": "4db9f5b6-f399-4bfa-b8f8-a07d41ed7e85",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "snapmenu-images" }],
  "triggers": { "crons": ["17 * * * *"] },
}
