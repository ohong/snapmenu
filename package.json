{
  "name": "snapmenu",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "deploy": "vercel deploy --prod",
    "test:prepare": "npm run build",
    "test": "npm run test:prepare && .venv/bin/pytest --browser chromium --browser webkit",
    "dev:api": "vercel dev --listen 8787",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.4.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
